{
  "name": "saguaro-crm",
  "version": "1.0.0",
  "description": "Saguaro CRM - Construction Project Management Platform",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "cap:build:ios": "next build && cap sync ios",
    "cap:build:android": "next build && cap sync android",
    "type-check": "tsc --noEmit",
    "audit": "node scripts/audit-ui-standards.mjs",
    "ship": "node scripts/ship.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf .next node_modules",
    "setup": "npx tsx scripts/run-migrations.ts && npx tsx scripts/setup-storage.ts",
    "setup:storage": "npx tsx scripts/setup-storage.ts",
    "setup:migrations": "npx tsx scripts/run-migrations.ts",
    "verify": "npx tsx scripts/verify-deployment.ts",
    "seed:templates": "curl -X POST $NEXT_PUBLIC_APP_URL/api/documents/seed-templates -H \"Authorization: Bearer $SAGUARO_API_SECRET\"",
    "seed:sandbox": "npx tsx -e \"import('./sandbox-manager').then(m => m.SandboxManager)\"",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --project-id jddfvugsaosvgllbkzch > lib/database.types.ts",
    "engine:check": "node scripts/sync-heatmap-engine.mjs --check",
    "engine:sync": "node scripts/sync-heatmap-engine.mjs --sync",
    "engine:test": "npx -y tsx lib/heatmap/sanity.test.ts",
    "test:pipeline": "npx -y tsx lib/sales-pipeline.harness.ts",
    "prebuild": "node tools/copy-web-ifc-wasm.mjs && node tools/build-model-engine.mjs && npm run check:style-escapes && npm run check:design-system",
    "check:style-escapes": "node tools/check-style-escapes.mjs --selftest && node tools/check-style-escapes.mjs",
    "check:design-system": "node tools/check-design-system.mjs",
    "e2e:sweep": "node tools/e2e-app-sweep.mjs",
    "e2e:nav": "node tools/e2e-nav-check.mjs",
    "e2e": "npm run e2e:nav && npm run e2e:sweep",
    "test:invites": "jest --testEnvironment node lib/invite-flow.sanity.test.ts",
    "test:items": "jest --testEnvironment node lib/items.sanity.test.ts",
    "test:list-tools": "jest --testEnvironment node lib/list-view.sanity.test.ts lib/list-tools.sanity.test.ts",
    "test:sanity": "jest --testEnvironment node lib/invite-flow.sanity.test.ts lib/items.sanity.test.ts lib/daily-log-sections.sanity.test.ts lib/budget-rollup.sanity.test.ts lib/commitments.sanity.test.ts lib/drawings.sanity.test.ts lib/panel-layout.sanity.test.ts lib/job-monthly.sanity.test.ts lib/reports.sanity.test.ts lib/cash-flow-projection.sanity.test.ts lib/schedule-cpm.sanity.test.ts lib/job-banner.sanity.test.ts lib/photo-views.sanity.test.ts lib/drawing-autolinks.sanity.test.ts lib/bid-leveling.sanity.test.ts lib/job-map.sanity.test.ts lib/submittal-workflow.sanity.test.ts lib/directory-view.sanity.test.ts lib/meetings.sanity.test.ts lib/model-viewer.sanity.test.ts lib/pay-app-status.sanity.test.ts lib/project-phase.sanity.test.ts lib/offline-sync.sanity.test.ts lib/job-permissions.sanity.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@aparajita/capacitor-biometric-auth": "^9.0.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@capacitor-mlkit/barcode-scanning": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/toast": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@saguaro/core": "github:DROCK1069/saguaro-core#v0.2.0",
    "@sentry/nextjs": "^8.55.0",
    "@supabase/auth-helpers-nextjs": "^0.9.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-datepicker": "^6.2.0",
    "@types/web-push": "^3.6.4",
    "@vercel/functions": "^1.6.0",
    "date-fns": "^3.3.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "mustache": "^4.2.0",
    "next": "^14.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "posthog-js": "^1.360.0",
    "posthog-node": "^4.0.0",
    "puppeteer": "^22.15.0",
    "react": "^18.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.1",
    "resend": "^4.0.0",
    "sharp": "^0.34.5",
    "stripe": "^17.0.0",
    "swr": "^2.4.1",
    "three": "^0.185.1",
    "web-ifc": "0.0.78",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@next/bundle-analyzer": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/leaflet": "^1.9.12",
    "@types/mustache": "^4.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "axe-core": "^4.7.2",
    "esbuild": "0.25.10",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "jsdom": "^22.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "crm",
    "construction",
    "project-management",
    "offline-sync",
    "quickbooks",
    "invoicing",
    "budget-tracking"
  ],
  "author": "Copper State Developments",
  "license": "PROPRIETARY"
}
